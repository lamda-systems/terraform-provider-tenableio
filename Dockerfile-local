FROM golang:1.26.6-bookworm

ARG TERRAFORM_VERSION=1.14.9
ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GORELEASER_VERSION=v2.8.2
ARG DELVE_VERSION=v1.27.0
ARG TFPLUGINDOCS_VERSION=v0.25.0
ARG GOSEC_VERSION=v2.28.0
ARG GOVULNCHECK_VERSION=v1.6.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    curl \
    unzip \
    jq \
    bash-completion \
    locales

RUN curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
    -o /tmp/terraform.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin/ \
    && rm /tmp/terraform.zip \
    && terraform --version

RUN go install github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION}

RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh \
    | sh -s -- -b /usr/local/bin ${GOLANGCI_LINT_VERSION}

RUN go install github.com/goreleaser/goreleaser/v2@${GORELEASER_VERSION}

RUN go install github.com/hashicorp/terraform-plugin-docs/cmd/tfplugindocs@${TFPLUGINDOCS_VERSION}

RUN go install github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION}
# govulncheck's vulnerability database is fetched at run time, so pinning the
# binary does not freeze vulnerability coverage.
RUN go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}

RUN echo en_US.UTF-8 UTF-8 >>/etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

ENV CGO_ENABLED=0
# GOFLAGS is deliberately unset so the devcontainer uses Go's default
# -mod=readonly, matching CI. Do not set -mod=mod: it lets any command that
# shells out to `go build` (tfplugindocs during `make docs`, for example)
# silently rewrite go.mod and go.sum. `go get` and `go mod tidy` still work.

CMD ["sleep", "infinity"]
